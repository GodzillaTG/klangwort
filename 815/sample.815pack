  "coverage": [],
  "lessons": [
    {
      "id": "lesson-rhythm",
      "title": "拍子、节拍与音值组合",
      "summary": "正确分组的目标是让拍点和强弱层级一眼可见。",
      "topic": "节奏节拍",
      "points": [
        "单拍子每小节有两个或三个单位拍；复拍子由同类单拍子组合。",
        "切分改变正常重音位置，但小节结构仍应清楚。",
        "连音符表示把通常的时值单位改作另一种均分。"
      ],
      "diagramId": "diagram-rhythm",
      "source": "两本指定教材对应章节的结构化整理；文字为原创概括"
    },
    {
      "id": "lesson-interval",
      "title": "音程构成、转位与解决",
      "summary": "音程要同时判断级数和音数。",
      "topic": "音程",
      "points": [
        "级数包含首尾两个音；先数级数再核对半音数。",
        "转位后度数相加为九，大小互换、增减互换、纯仍为纯。",
        "C♯ 到 G♯ 与 D♭ 到 A♭虽同为纯五度，但拼写语境不同。"
      ],
      "diagramId": "diagram-interval",
      "source": "两本指定教材对应章节的结构化整理；文字为原创概括"
    },
    {
      "id": "lesson-major-minor",
      "title": "大小调与调号",
      "summary": "调号、主音和音阶结构共同确定调性。",
      "topic": "调式调性",
      "points": [
        "自然大调按全全半全全全半排列。",
        "自然小调与关系大调共享调号；和声小调升高第七级。",
        "旋律小调上行与下行的处理必须结合教材约定和谱面方向。"
      ],
      "diagramId": "diagram-fifths",
      "source": "两本指定教材对应章节的结构化整理；文字为原创概括"
    }
  ],
