  "questions": [
    {
      "id": "q-rhythm-01",
      "type": "choice",
      "topic": "节奏节拍",
      "prompt": "6/8 拍通常按哪种方式理解？",
      "options": [
        "六个独立强拍",
        "两个单位拍，每拍三等分",
        "三个单位拍，每拍二等分",
        "自由节拍"
      ],
      "answer": 1,
      "lessonId": "lesson-rhythm",
      "steps": [
        "6/8 是常见复二拍子。",
        "每小节两个单位拍，每个单位拍含三个八分音符。"
      ],
      "trap": "分母只说明基本时值单位，不直接给出强拍数量。",
      "source": "依据指定教材知识点编写的原创变式",
      "answerStatus": "整理答案"
    },
    {
      "id": "q-notation-01",
      "type": "notation",
      "topic": "音程",
      "prompt": "请拼写 C♯4 上方的纯五度（保留正确字母级数）。",
      "slots": [
        {
          "duration": "quarter"
        }
      ],
      "answer": [
        {
          "letter": "G",
          "accidental": "#",
          "octave": 4,
          "duration": "quarter"
        }
      ],
      "lessonId": "lesson-interval",
      "steps": [
        "C 到 G 是五度。",
        "C♯ 的纯五度是 G♯。"
      ],
      "trap": "A♭ 与 G♯等音，但从 C 到 A 是六度拼写，不能判为纯五度。",
      "source": "依据指定教材知识点编写的原创变式",
      "answerStatus": "整理答案"
    },
    {
      "id": "q-interval-01",
      "type": "choice",
      "topic": "音程",
      "prompt": "大三度转位后成为？",
      "options": [
        "大六度",
        "小六度",
        "纯六度",
        "减六度"
      ],
      "answer": 1,
      "lessonId": "lesson-interval",
      "steps": [
        "转位度数相加为九：3+6=9。",
        "大音程转位为小音程。"
      ],
      "trap": "只记度数、不转换性质。",
      "source": "依据指定教材知识点编写的原创变式",
      "answerStatus": "整理答案"
    },
    {
      "id": "q-key-01",
      "type": "choice",
      "topic": "调式调性",
      "prompt": "G 大调的调号包含？",
      "options": [
        "F♯",
        "B♭",
        "F♯与C♯",
        "无升降号"
      ],
      "answer": 0,
      "lessonId": "lesson-major-minor",
      "steps": [
        "按五度圈从 C 向上一个纯五度得到 G。",
        "升号次序第一个是 F♯。"
      ],
      "trap": "不要把属音 G 本身误当成变化音。",
      "source": "依据指定教材知识点编写的原创变式",
      "answerStatus": "整理答案"
    }
  ],
