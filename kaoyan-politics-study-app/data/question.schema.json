{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kaoyan Politics Original Question",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "subject_id", "chapter_id", "knowledge_node_ids", "type", "difficulty", "stem", "options", "correct_answers", "one_line_point", "option_explanations", "memory_cue", "confusion_comparison", "trap", "reinforcement_question_id", "source", "original"],
    "properties": {
      "id": {"type": "string", "minLength": 3},
      "type": {"enum": ["single", "multiple"]},
      "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
      "knowledge_node_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "correct_answers": {"type": "array", "minItems": 1, "items": {"enum": ["A", "B", "C", "D", "E", "F"]}},
      "original": {"const": true}
    }
  }
}
